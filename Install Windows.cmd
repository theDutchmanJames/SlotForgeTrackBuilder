@echo off
setlocal
set "SLOTFORGE_SETUP_SOURCE=%~dp0"
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; $source=$env:SLOTFORGE_SETUP_SOURCE; $manifest=Get-Content -LiteralPath (Join-Path $source 'installer/node-runtimes.json') -Raw | ConvertFrom-Json; $cpu=if($env:PROCESSOR_ARCHITEW6432){$env:PROCESSOR_ARCHITEW6432}else{$env:PROCESSOR_ARCHITECTURE}; $arch=if($cpu -eq 'ARM64'){'arm64'}elseif($cpu -eq 'AMD64'){'x64'}else{throw 'Supported Windows CPUs are x64 and arm64.'}; $entry=$manifest.platforms.('win32-'+$arch); $root=if($env:SLOTFORGE_HOME){$env:SLOTFORGE_HOME}else{Join-Path $env:LOCALAPPDATA 'SlotForgeTrackBuilder'}; $full=[IO.Path]::GetFullPath($root); if($full -eq [IO.Path]::GetPathRoot($full) -or $full -eq $env:USERPROFILE){throw 'Choose a dedicated SlotForge folder.'}; $cache=Join-Path $root '.setup-cache'; New-Item -ItemType Directory -Path $cache -Force | Out-Null; $archive=Join-Path $cache $entry.file; if(!(Test-Path -LiteralPath $archive)){ $offline=Join-Path (Join-Path $source 'installer/runtime-archives') $entry.file; if(Test-Path -LiteralPath $offline){Copy-Item -LiteralPath $offline -Destination $archive}else{Write-Host 'Downloading the private Node.js runtime from nodejs.org (first install only)...'; Invoke-WebRequest -UseBasicParsing -Uri $entry.url -OutFile $archive} }; $sha=[Security.Cryptography.SHA256]::Create(); $stream=[IO.File]::OpenRead($archive); try{$digest=[BitConverter]::ToString($sha.ComputeHash($stream)).Replace('-','').ToLowerInvariant()}finally{$stream.Dispose();$sha.Dispose()}; if($digest -ne $entry.sha256){throw 'Runtime checksum failed. Remove the cached runtime archive and retry.'}; Add-Type -AssemblyName System.IO.Compression.FileSystem; $unpack=Join-Path $cache ('extract-'+[guid]::NewGuid().ToString()); [IO.Compression.ZipFile]::ExtractToDirectory($archive,$unpack); $folder=[IO.Path]::GetFileNameWithoutExtension($entry.file); $node=Join-Path (Join-Path $unpack $folder) 'node.exe'; $installArgs=@((Join-Path $source 'installer/install.cjs'),'--home',$root,'--no-open'); if($env:SLOTFORGE_NO_SHORTCUTS -eq '1'){$installArgs+='--no-shortcuts'}; & $node @installArgs; if($LASTEXITCODE -ne 0){exit $LASTEXITCODE}; if($env:SLOTFORGE_NO_OPEN -ne '1'){Start-Process -FilePath (Join-Path $root 'Start SlotForge.cmd') -WindowStyle Hidden}; Write-Host ('Installed in '+$root); Write-Host ('User data: '+(Join-Path $root 'data'))"
if errorlevel 1 (
 echo Setup failed. Your existing data has not been removed.
 pause
 exit /b 1
)
