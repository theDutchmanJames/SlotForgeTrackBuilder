    "containsExecutableCode": false
  },
  "scope": {
    "basis": "Initial documented selection of road pieces and track-mounted accessories.",
    "availability": "Historical and current products are mixed; catalogue inclusion does not imply current availability.",
    "excluded": [
      "Later Monte Carlo additions",
      "1:24 cars and electrical spares",
      "Unmeasured aftermarket borders"
    ]
  },
  "defaults": {
    "trackWidthMm": 180,
    "laneSpacingMm": 90,
    "status": "nominal",
    "note": "Car scale is descriptive. Physical dimensions are millimetres. Centred slot offsets are a nominal model, not manufacturing tolerances."
  },
  "visualStyle": {
    "basis": "Original schematic SVG interpretations of the cited product/catalogue illustrations; connector details are illustrative.",
    "road": "#262829"
  },
  "sources": [
    {
      "id": "fl-catalogue",
      "title": "Fleischmann Auto-Rallye manufacturer catalogue 1968–1969",
      "url": "https://finslot.net/arkisto/wp-content/uploads/2022/03/Fleischmann-Auto-Rallye-1968-1969-de.pdf",
      "pages": [
        41,
        42,
        43
      ],
      "note": "Printed pages 41–43 (PDF pages 5–7) visually inspected. 3100/3102/3104 dimensions and 3110/3111/3112 road-edge radii 95/275/455/635 mm."
    }
  ],
  "sourceIssues": [
    {
      "field": "Slot spacing",
      "detail": "The catalogue dimensions road edges, not slot centres. This nominal model assumes two centred slots 90 mm apart in the 180 mm road. Per-lane lengths remain estimates until independently measured."
    },
    {
      "field": "Historical scope",
      "detail": "This first selection follows the 1968–1969 catalogue. Later products, including 3123 lane crossover, 3124 hump, 3125 looping and 3154 banked bowl, are outside this pack."
    },
    {
      "field": "Special pieces",
      "detail": "Electrical connection housings, junction, chicane, banking and accessories remain reference-only; complete route and attachment geometry is unresolved."
    }
  ],
